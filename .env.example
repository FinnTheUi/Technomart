APP_NAME=Technomart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Development uses database/database.sqlite. PHPUnit uses an isolated in-memory
# SQLite database, so automated tests can never overwrite local demo data.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Leave blank to use storage/app/backups.
BACKUP_PATH=
# Required outside local development. Generate a long random value and store it
# separately; an encrypted backup cannot be restored without it.
BACKUP_PASSWORD=

# Privacy retention is disabled until the organization approves these periods.
DATA_RETENTION_ENABLED=false
AUDIT_RETENTION_DAYS=730
MESSAGE_RETENTION_DAYS=365
READ_NOTIFICATION_RETENTION_DAYS=90
PAYMENT_PROOF_RETENTION_DAYS=365

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Initial admin account (php artisan db:seed) ──
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=

# ── Google OAuth (Sign up / Sign in with Google) ──
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and add
# ${APP_URL}/auth/google/callback as an authorized redirect URI.
# NEVER put the plain client secret here. Store it encrypted with:
#   php artisan secret:encrypt google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_ENCRYPTED=
GOOGLE_REDIRECT_URI=/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=gmail.com

# ── Billing ──
# Late fee applied once when a bill becomes overdue: amount x percent / 100 + fixed.
LATE_FEE_PERCENT=5
LATE_FEE_FIXED=0
LATE_FEE_GRACE_DAYS=0
# Shown to tenants who pay by GCash and submit the reference number for verification.
GCASH_ACCOUNT_NAME=Technomart
GCASH_ACCOUNT_NUMBER=
RECEIPT_PREFIX=OR
ORDER_AUTO_CANCEL_DAYS=3

# ── PayMongo online payments (optional; hidden until both secrets are set) ──
# Store secrets encrypted:  php artisan secret:encrypt paymongo-secret
#                           php artisan secret:encrypt paymongo-webhook
# Webhook URL: {APP_URL}/webhooks/paymongo  (event: checkout_session.payment.paid)
PAYMONGO_SECRET_KEY_ENCRYPTED=
PAYMONGO_WEBHOOK_SECRET_ENCRYPTED=
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,card

# ── Stall layout (config/stalls.php): Floor 1 = Stalls 1-24, Floor 2 = Carts 1-10 ──
# Starting price for auto-generated stalls; managers adjust each stall afterwards.
STALL_DEFAULT_PRICE_FLOOR_1=5000
STALL_DEFAULT_PRICE_FLOOR_2=2500
# How often stall maps refresh live availability (seconds).
STALL_LIVE_REFRESH_SECONDS=15

# ── Predictive analytics (ml/) ──
ML_PYTHON_BINARY=python
ML_TIMEOUT=15
ML_MIN_TRAINING_ROWS=30
